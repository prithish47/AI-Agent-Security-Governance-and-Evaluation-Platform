# =============================================================================
# AgentGuard Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed.
# NEVER commit the .env file with real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=agentguard_dev_password
POSTGRES_DB=agentguard
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async connection string (used by backend)
DATABASE_URL=postgresql+asyncpg://agentguard:agentguard_dev_password@db:5432/agentguard

# -----------------------------------------------------------------------------
# Backend Security
# -----------------------------------------------------------------------------
# IMPORTANT: Change this in production! Use a long random string.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-CHANGE-IN-PRODUCTION-use-secrets-token-urlsafe-64

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Backend Application
# -----------------------------------------------------------------------------
APP_NAME=AgentGuard
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Agent Runtime
GLOBAL_ITERATION_CEILING=20

# -----------------------------------------------------------------------------
# AI Provider Configuration (all optional for development)
# -----------------------------------------------------------------------------

# OpenAI-compatible API
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# Google Gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-pro

# Ollama (local models)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
